{
  "name": "codegraph-ext",
  "version": "0.1.0",
  "description": "CodeGraph explore extension for pi and oh-my-pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrazyTomatoOo/codegraph-ext.git"
  },
  "homepage": "https://github.com/CrazyTomatoOo/codegraph-ext#readme",
  "bugs": {
    "url": "https://github.com/CrazyTomatoOo/codegraph-ext/issues"
  },
  "main": "index.ts",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --types node core.ts prompt-hook.ts register.ts",
    "prepack": "npm run typecheck && npm test"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./omp.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "oh-my-pi",
    "pi-extension",
    "codegraph"
  ],
  "peerDependencies": {
    "typebox": "*"
  },
  "files": [
    "README.md",
    "LICENSE",
    "core.ts",
    "index.ts",
    "omp.ts",
    "prompt-hook.ts",
    "register.ts"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.20.6",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
